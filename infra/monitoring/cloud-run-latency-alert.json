{
  "displayName": "SuccessPro staging: Cloud Run latency",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "p95 request latency exceeds 20 seconds",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"successpro-web-staging\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 20000,
        "duration": "300s",
        "aggregations": [{ "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_PERCENTILE_95", "groupByFields": ["resource.label.\"service_name\""] }]
      }
    }
  ],
  "alertStrategy": { "autoClose": "86400s" },
  "documentation": {
    "content": "Identify whether latency is concentrated in document parsing, AI generation, or downstream sources. Preserve request metadata only; do not copy private resume text into tickets.",
    "mimeType": "text/markdown"
  }
}
