RESUME_NATIVE_PIPELINE_ENABLED=false
NEXT_PUBLIC_RESUME_NATIVE_PIPELINE_ENABLED=false
RESUME_NATIVE_LOCAL_USER_ID=local-developer
RESUME_LOCAL_STORAGE_ROOT=.local/resumes
RESUME_TEMP_ROOT=.local/resume-temp
RESUME_MAX_FILE_SIZE_MB=20
RESUME_MAX_PAGES=25
RESUME_CHUNK_PAGES=5
RESUME_RENDER_DPI=144
RESUME_PROCESSING_TIMEOUT_SECONDS=900
RESUME_JOB_LEASE_SECONDS=90
RESUME_HEARTBEAT_SECONDS=20
RESUME_MAX_RETRIES=3
RESUME_MYSQL_URL=mysql://successpro:successpro@127.0.0.1:3306/successpro_local
RESUME_REDIS_URL=redis://127.0.0.1:6379
RESUME_AI_PROVIDER=mock
# Optional dedicated Vision model. Otherwise Vision uses GEMINI_FALLBACK_MODEL.
GEMINI_VISION_FALLBACK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_RETRIES=1
GEMINI_PRO_ENABLED=false
LIBREOFFICE_BINARY=soffice
